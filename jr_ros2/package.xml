<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jr_ros2</name>
  <version>0.1.0</version>
  <description>
    CyberBeast joint module ROS 2 integration (CYBERBEAST protocol over CAN/CAN-FD).
    Contains the realtime core library (jr_core, rclcpp-free), the lifecycle driver node
    and the ROS-native tools. Protocol/frames/endpoints are handled by JointSDK.
  </description>
  <maintainer email="dev@example.com">CyberBeast</maintainer>
  <license>Proprietary</license>

  <!-- jr_core 本身不依赖 rclcpp；下面这些是**节点/工具**（WP2/WP4）需要的，
       因此现在只是声明，CMake 里按需 find_package。 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>diagnostic_updater</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>jr_interfaces</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>diagnostic_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
